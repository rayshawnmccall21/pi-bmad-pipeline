{
  "name": "pi-bmad-pipeline",
  "version": "0.1.0",
  "description": "Supervises discovered-YAML FSM execution with hermetic Pi children, durable state, and redacted JSONL events.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rundef": "./src/rundef/index.ts",
    "./events": "./src/events/index.ts",
    "./executors/pi": "./src/executors/pi/index.ts"
  },
  "bin": {
    "bmad-pipeline": "dist/src/cli.js"
  },
  "files": [
    "dist/",
    "src/",
    "scripts/",
    "quality/",
    "skills/",
    "README.md"
  ],
  "pi": {
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "tsc && bun build src/cli.ts --target=node --outfile=dist/src/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "precrap": "npm run build",
    "crap": "vitest run --coverage && node scripts/crap-report.mjs",
    "crap:ratchet": "node scripts/crap-ratchet.mjs",
    "crap:update-baseline": "node scripts/crap-ratchet.mjs --update-baseline",
    "knip": "knip",
    "conformance": "vitest run --config vitest.conformance.config.ts",
    "check:pi-bmad": "node scripts/check-pi-bmad-freshness.mjs",
    "check": "npm run check:pi-bmad && npm run typecheck && npm run format:check && npm run lint && npm run test:coverage && npm run crap && npm run conformance && npm run test:e2e && npm run knip"
  },
  "keywords": [
    "pi-package",
    "bmad",
    "pipeline",
    "sdlc",
    "supervisor",
    "ci",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "pi-bmad": "file:../pi-bmad",
    "typebox": "^1.1.24",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@types/node": "^25.7.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vitest": "^0.5.4",
    "knip": "^5.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.0.0"
  }
}
