{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-gates.dispositions.v1",
  "type": "object",
  "properties": {
    "checkpoint": {
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "blocked"
      ]
    },
    "schema": {
      "const": "dispositions.v1"
    },
    "storyId": {
      "type": "string"
    },
    "queueRef": {
      "type": "string"
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fingerprint": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "fix",
              "false_positive",
              "outdated_fixed",
              "duplicate",
              "defer",
              "needs_human"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "commitSha": {
                "type": "string"
              },
              "testId": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "canonicalFingerprint": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "ruledBy": {
            "description": "Present only on dispositions translated from an authenticated human /rule reply by collect_rulings.py. defer is valid only with ruledBy; a human-ruled false_positive resolves the thread.",
            "type": "object",
            "properties": {
              "login": { "type": "string" },
              "id": { "type": "integer" },
              "commentId": { "type": "integer" },
              "bodySha256": { "type": "string" },
              "ruledAt": { "type": "string" }
            },
            "required": ["login", "id", "commentId", "bodySha256"],
            "additionalProperties": false
          }
        },
        "required": [
          "fingerprint",
          "disposition",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "checkpoint",
    "status",
    "schema",
    "storyId",
    "dispositions"
  ],
  "additionalProperties": false
}
